# ─────────────────────────────────────────────────────────────────────────────
# InHome TV Repair — environment variables
# Copy this file to `.env.local` (dev) or set these in your Railway/Vercel project.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram (existing — callback request notifications + diagnostic bot) ──
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_group_chat_id
# Admin's personal Telegram user ID — diagnostic details are sent here via DM
TELEGRAM_DIAGNOSTIC_ADMIN_ID=your_personal_telegram_user_id
# Optional: secret token Telegram sends with each webhook update
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# ── Stripe ($25 Online Diagnostic payments) ─────────────────────────────────
# Server secret key (sk_live_... or sk_test_...)
STRIPE_SECRET_KEY=your_stripe_secret_key
# Publishable key (pk_live_... or pk_test_...) — exposed to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Signing secret from your Stripe webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
# Public base URL of your deployed site (used for Stripe return_url)
PUBLIC_BASE_URL=http://localhost:3000

# ── Postgres (Railway — diagnostic order tracking) ──────────────────────────
# Provision a Postgres database on Railway and paste its connection string here.
DATABASE_URL=postgresql://user:password@host:port/railway

# ── Railway S3-compatible bucket (diagnostic media uploads) ─────────────────
# Create a bucket in your Railway project and use its credentials here.
S3_ENDPOINT=https://bucket.proxy.rlwy.net
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your_bucket_name

# ── Resend (customer confirmation + verdict emails) ─────────────────────────
# Get an API key at https://resend.com and verify your sending domain.
RESEND_API_KEY=your_resend_api_key
# Must be a verified sender. For testing only, use: onboarding@resend.dev
EMAIL_FROM=InHome TV Repair <diagnostics@inhometvrepair.com>
